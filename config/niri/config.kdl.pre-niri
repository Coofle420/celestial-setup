// niri config — gaming / content workstation with Noctalia v5 shell
// Docs: https://niri-wm.github.io/niri/   https://docs.noctalia.dev/noctalia/compositor-settings/niri/
// Regenerate exact mode strings with `niri msg outputs`.

input {
    keyboard {
        xkb {
            layout "us"
        }
        numlock
    }

    mouse {
        // raw mouse input for gaming — no pointer acceleration
        accel-profile "flat"
    }

    touchpad {
        tap
        natural-scroll
    }
}

/////////////////////////////////////////////////////////////////////
// Outputs
//   DP-2  = KTC     — LEFT  — 2560x1440 @ 200 Hz
//   DP-3  = Samsung — RIGHT — 1920x1080 @ 165 Hz
// VRR on-demand: engages for fullscreen games, off on the static desktop.
/////////////////////////////////////////////////////////////////////

output "DP-2" {
    mode "2560x1440@200.000"
    scale 1
    position x=0 y=0
    variable-refresh-rate on-demand=true
}

output "DP-3" {
    mode "1920x1080@165.000"
    scale 1
    position x=2560 y=0
    variable-refresh-rate on-demand=true
}

/////////////////////////////////////////////////////////////////////
// Layout
/////////////////////////////////////////////////////////////////////

layout {
    gaps 12
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-color "#7fc8ff"
        inactive-color "#3a3a3a"
    }
    border { off; }
    shadow {
        on
        softness 24
        spread 4
        offset x=0 y=4
        color "#00000055"
    }
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

// Let Noctalia trigger window activation / notification actions.
debug {
    honor-xdg-activation-with-invalid-serial
}

/////////////////////////////////////////////////////////////////////
// Named workspaces (pinned to a monitor)
/////////////////////////////////////////////////////////////////////

workspace "game" { open-on-output "DP-2"; }
workspace "web"  { open-on-output "DP-2"; }
workspace "chat" { open-on-output "DP-3"; }

/////////////////////////////////////////////////////////////////////
// Environment
/////////////////////////////////////////////////////////////////////

environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    MOZ_ENABLE_WAYLAND "1"
    QT_QPA_PLATFORM "wayland;xcb"
    SDL_VIDEODRIVER "wayland,x11"
    _JAVA_AWT_WM_NONREPARENTING "1"
}

/////////////////////////////////////////////////////////////////////
// Startup
/////////////////////////////////////////////////////////////////////

spawn-at-startup "/usr/libexec/polkit-gnome-authentication-agent-1"
spawn-at-startup "/usr/bin/gnome-keyring-daemon" "--start" "--components=secrets,ssh"

// Noctalia v5 shell — bar / launcher / notifications / OSD / lock / wallpaper
spawn-at-startup "noctalia"

// clipboard history (feeds Noctalia's clipboard widget)
spawn-sh-at-startup "wl-paste --type text  --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"

/////////////////////////////////////////////////////////////////////
// Window rules
/////////////////////////////////////////////////////////////////////

// Noctalia settings window floats
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Steam main window -> game workspace
window-rule {
    match app-id=r#"^steam$"#
    open-on-workspace "game"
}

// Games (Steam apps) + gamescope -> game workspace, fullscreen, no shadow
window-rule {
    match app-id=r#"^steam_app_"#
    match app-id=r#"^gamescope$"#
    open-on-workspace "game"
    open-fullscreen true
    shadow { off; }
}

// Firefox / browser picture-in-picture floats
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Discord / chat -> chat workspace on the Samsung
window-rule {
    match app-id=r#"(?i)(discord|vesktop|webcord)"#
    open-on-workspace "chat"
}

// mpv floats
window-rule {
    match app-id=r#"^mpv$"#
    open-floating true
}

/////////////////////////////////////////////////////////////////////
// Layer rules (Noctalia blur — only takes effect if compositor blur on)
/////////////////////////////////////////////////////////////////////

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

/////////////////////////////////////////////////////////////////////
// Keybinds
/////////////////////////////////////////////////////////////////////

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Terminal: foot" { spawn "foot"; }
    Mod+D hotkey-overlay-title="Launcher: fuzzel" { spawn "fuzzel"; }
    Mod+B hotkey-overlay-title="Browser: Helium" { spawn "helium"; }
    Mod+E hotkey-overlay-title="Files" { spawn-sh "xdg-open ~"; }

    // --- Noctalia shell (IPC) ---
    Mod+Space hotkey-overlay-title="Noctalia launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+S hotkey-overlay-title="Noctalia control center" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Shift+Comma hotkey-overlay-title="Noctalia settings" { spawn-sh "noctalia msg settings-toggle"; }
    Mod+N hotkey-overlay-title="Notifications" { spawn-sh "noctalia msg panel-toggle notifications"; }
    Super+Alt+L hotkey-overlay-title="Lock screen" { spawn-sh "noctalia msg session lock"; }
    Mod+V hotkey-overlay-title="Clipboard history" { spawn-sh "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; }

    // --- Audio / brightness via Noctalia (shows OSD) ---
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+L     { focus-monitor-right; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M { maximize-window-to-edges; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+Shift+V { toggle-window-floating; }
    Mod+W { toggle-column-tabbed-display; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}
